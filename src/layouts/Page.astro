---
import Base from './Base.astro';
import EntryList from '../components/EntryList.astro';
import { useI18n } from '../i18n';
import type { Section } from '../data/site';

interface Props {
  title: string;
  lead?: string;
  sections?: Section[];
}

const { title, lead, sections = [] } = Astro.props;
const { t, data } = useI18n(Astro.url);
const { site } = data;
---

<Base title={`${title} — ${site.name} ${site.nameEn}`} description={lead ?? site.description}>
  <main class="container">
    <header class="page-header">
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </header>

    {
      sections.length > 1 && (
        <nav class="toc" aria-label={t.toc}>
          {sections.map((section) => (
            <a href={`#${section.id}`}>{section.label}</a>
          ))}
        </nav>
      )
    }

    <slot name="before" />

    {
      sections.map((section) => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.label}</h2>
          <EntryList items={section.items} detailed />
        </section>
      ))
    }

    <slot />
  </main>
</Base>

<style>
  .page-header {
    padding: 5.5rem 0 3rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .lead {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 1.1875rem;
    max-width: 38rem;
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 4.5rem;
  }

  .toc a {
    padding: 0.3125rem 0.875rem;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--fg);
  }

  section {
    margin-bottom: 5.5rem;
    scroll-margin-top: 6rem;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
</style>
