---
import { Image } from 'astro:assets';
import '../styles/global.css';
import avatar from '../assets/avatar.jpg';
import { useI18n, basePath, localize, locales, pages, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { locale, t, data } = useI18n(Astro.url);
const { site } = data;
const { title = site.title, description = site.description } = Astro.props;

const path = basePath(Astro.url);
const canonical = new URL(localize(locale, path), Astro.site);
const other: Locale = locale === 'zh' ? 'en' : 'zh';
// 404 頁沒有對應的另一語言版本，切換時回到對方首頁。
const isKnownPage = (pages as readonly string[]).includes(path);
const switchHref = localize(other, isKnownPage ? path : '/');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locales[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      isKnownPage &&
        (Object.keys(locales) as Locale[]).map((l) => (
          <link rel="alternate" hreflang={locales[l].htmlLang} href={new URL(localize(l, path), Astro.site)} />
        ))
    }
    {isKnownPage && <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_TW' : 'en_US'} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localize(locale, '/')}>
        <span class="brand-mark">
          <Image src={avatar} alt="" width={28} height={28} densities={[1, 2, 3]} loading="eager" />
        </span>
        <span class="visually-hidden">{site.name}</span>
      </a>
      <nav aria-label={t.mainNav}>
        <ul>
          {
            pages.map((page, i) => (
              <li>
                <a href={localize(locale, page)} aria-current={path === page ? 'page' : undefined}>
                  {t.nav[i]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <slot />
    <footer class="site-footer container">
      <p>Copyright © {year} {site.name} {site.nameEn}. {t.rights}</p>
      <!-- 參考 Apple.com：語言切換放在頁尾右側 -->
      <a class="lang" href={switchHref} hreflang={locales[other].htmlLang} lang={locales[other].htmlLang}>
        {locales[other].label}
      </a>
    </footer>
  </body>
</html>

<style>
  /* 置中的小膠囊導覽列：只放頭像和連結，寬度跟著內容走 */
  .site-header {
    position: sticky;
    top: 0.875rem;
    z-index: 50;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: fit-content;
    max-width: calc(100% - 1.5rem);
    margin: 0.875rem auto 0;
    padding: 0.3125rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    box-shadow:
      0 4px 20px var(--glass-shadow),
      0 1px 3px var(--glass-shadow-soft);
  }

  /* 模糊放在偽元素上，避免 backdrop-filter 影響子元素的定位 */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    pointer-events: none;
  }

  .brand {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    transition: transform 0.2s;
  }

  .brand:hover {
    transform: scale(1.06);
  }

  .brand-mark,
  .brand-mark :global(img) {
    display: block;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    object-fit: cover;
  }

  nav {
    min-width: 0;
  }

  nav ul {
    display: flex;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  nav a {
    display: block;
    padding: 0.4375rem 0.875rem;
    border-radius: 999px;
    color: var(--nav-fg);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }

  nav a:hover {
    color: var(--nav-active);
    background: var(--glass-chip);
  }

  nav a[aria-current='page'] {
    color: var(--nav-active);
    background: var(--glass-chip);
    font-weight: 600;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .site-header {
      gap: 0;
    }

    nav a {
      padding: 0.4375rem 0.5rem;
      font-size: 0.8125rem;
    }
  }

  /* 頁尾：版權在左、語言切換在右（參考 Apple.com） */
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
  }

  .site-footer p {
    margin: 0;
  }

  .lang {
    color: var(--fg);
    text-decoration: none;
  }

  .lang:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .site-footer {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
