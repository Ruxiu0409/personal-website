---
import { Image } from 'astro:assets';
import '../styles/global.css';
import avatar from '../assets/avatar.jpg';
import { useI18n, basePath, localize, locales, pages, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { locale, t, data } = useI18n(Astro.url);
const { site } = data;
const { title = site.title, description = site.description } = Astro.props;

const path = basePath(Astro.url);
const canonical = new URL(localize(locale, path), Astro.site);
const other: Locale = locale === 'zh' ? 'en' : 'zh';
// 404 頁沒有對應的另一語言版本，切換時回到對方首頁。
const isKnownPage = (pages as readonly string[]).includes(path);
const switchHref = localize(other, isKnownPage ? path : '/');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locales[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      isKnownPage &&
        (Object.keys(locales) as Locale[]).map((l) => (
          <link rel="alternate" hreflang={locales[l].htmlLang} href={new URL(localize(l, path), Astro.site)} />
        ))
    }
    {isKnownPage && <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_TW' : 'en_US'} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localize(locale, '/')}>
        <span class="brand-mark">
          <Image src={avatar} alt="" width={28} height={28} densities={[1, 2, 3]} loading="eager" />
        </span>
        <span class="brand-name">{site.name}</span>
      </a>
      <nav aria-label={t.mainNav}>
        <ul>
          {
            pages.map((page, i) => (
              <li>
                <a href={localize(locale, page)} aria-current={path === page ? 'page' : undefined}>
                  {t.nav[i]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <slot />
    <footer class="site-footer container">
      <p>Copyright © {year} {site.name} {site.nameEn}. {t.rights}</p>
      <!-- 參考 Apple.com：語言切換放在頁尾右側 -->
      <a class="lang" href={switchHref} hreflang={locales[other].htmlLang} lang={locales[other].htmlLang}>
        {locales[other].label}
      </a>
    </footer>
  </body>
</html>

<style>
  /* 參考 iOSClub.tw：浮在頁面上方的毛玻璃膠囊導覽列 */
  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 50;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: calc(100% - 2rem);
    max-width: 72rem;
    margin: 1rem auto 0;
    padding: 0.625rem 0.75rem 0.625rem 1rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      0 4px 24px var(--glass-shadow),
      0 1px 4px var(--glass-shadow-soft);
  }

  /* 模糊放在偽元素上，避免 backdrop-filter 影響子元素的定位 */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    pointer-events: none;
  }

  .brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
    color: var(--fg);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--fg);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-chip);
    box-shadow: inset 0 1px 2px var(--glass-highlight);
    transition: transform 0.3s, background 0.3s;
  }

  .brand:hover .brand-mark {
    transform: scale(1.05);
  }

  .brand-mark :global(img) {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  nav {
    flex: 1;
    min-width: 0;
  }

  nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0 1rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  nav li {
    flex: 1;
  }

  nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--nav-fg);
    font-size: 1rem;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.3s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--nav-active);
    background: var(--glass-chip);
    border-color: var(--glass-border);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      0 2px 8px rgba(0, 0, 0, 0.06);
  }

  nav a[aria-current='page'] {
    font-weight: 600;
  }

  /* 手機：膠囊改成兩行的圓角卡片，上排名字，下排五個連結 */
  @media (max-width: 720px) {
    .site-header {
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
      padding: 0.5rem;
      border-radius: 1.5rem;
    }

    .brand-name {
      font-size: 1.0625rem;
    }

    nav {
      order: 3;
      flex-basis: 100%;
    }

    nav ul {
      justify-content: space-between;
      gap: 0;
      padding: 0;
    }

    nav li {
      flex: none;
    }

    nav a {
      padding: 0.375rem 0.375rem;
      font-size: 0.8125rem;
    }
  }

  /* 頁尾：版權在左、語言切換在右（參考 Apple.com） */
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
  }

  .site-footer p {
    margin: 0;
  }

  .lang {
    color: var(--fg);
    text-decoration: none;
  }

  .lang:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .site-footer {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
