---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`找不到頁面 — ${site.handle}`}>
  <main class="container">
    <p class="code">404</p>
    <h1>找不到這個頁面</h1>
    <p><a href="/">回到首頁</a></p>
  </main>
</Base>

<style>
  main {
    padding: 8rem 1.5rem;
  }

  .code {
    margin: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin: 0.5rem 0 1.5rem;
    letter-spacing: -0.02em;
  }
</style>
