---
import Base from '../layouts/Base.astro';
import { site, projects } from '../data/site';

const year = new Date().getFullYear();
---

<Base>
  <main class="container">
    <header class="hero">
      <p class="eyebrow">{site.location}</p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">{site.intro}</p>
      <nav class="links" aria-label="社群連結">
        {site.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </header>

    <section aria-labelledby="projects">
      <h2 id="projects">作品</h2>
      <ul class="projects">
        {
          projects.map((project) => (
            <li>
              <h3>
                {project.href ? <a href={project.href}>{project.name}</a> : project.name}
              </h3>
              <p>{project.description}</p>
              <ul class="tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="container">
    <p>© {year} {site.name}</p>
  </footer>
</Base>

<style>
  .hero {
    padding: 7rem 0 4rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .tagline {
    margin: 1rem 0 0;
    font-size: 1.25rem;
  }

  .intro {
    margin: 1.25rem 0 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
    font-weight: 500;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .projects > li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .projects p {
    margin: 0.375rem 0 0;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.875rem 0 0;
    padding: 0;
  }

  .tags li {
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  footer {
    padding-top: 4rem;
    padding-bottom: 3rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  footer p {
    margin: 0;
  }
</style>
