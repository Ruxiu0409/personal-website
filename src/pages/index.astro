---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/avatar.jpg';
import { site, sections } from '../data/site';

const year = new Date().getFullYear();
---

<Base>
  <main class="container">
    <header class="hero">
      <Image
        class="avatar"
        src={avatar}
        alt={site.name}
        width={112}
        height={112}
        densities={[1, 2, 3]}
        loading="eager"
      />
      <p class="eyebrow">{site.location}</p>
      <h1>{site.name} <span class="name-en">{site.nameEn}</span></h1>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">{site.intro}</p>
      <nav class="links" aria-label="社群連結">
        {site.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </header>

    {
      sections.map((section) => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.label}</h2>
          <ul class="entries">
            {section.items.map((item) => (
              <li>
                <div class="entry-head">
                  <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                  <span class="date">{item.date}</span>
                </div>
                {item.subtitle && <p class="subtitle">{item.subtitle}</p>}
                {item.description && <p>{item.description}</p>}
                {item.tags && (
                  <ul class="tags">
                    {item.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>

  <footer class="container">
    <p>© {year} {site.name}</p>
  </footer>
</Base>

<style>
  .hero {
    padding: 7rem 0 4rem;
  }

  .avatar {
    display: block;
    width: 7rem;
    height: 7rem;
    margin-bottom: 2rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .tagline {
    margin: 1rem 0 0;
    font-size: 1.25rem;
  }

  .intro {
    margin: 1.25rem 0 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
    font-weight: 500;
  }

  .name-en {
    display: block;
    margin-top: 0.5rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0;
  }

  section {
    margin-bottom: 3.5rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .entries > li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .date {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .entries p {
    margin: 0.375rem 0 0;
    color: var(--muted);
  }

  .entries .subtitle {
    margin-top: 0.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.875rem 0 0;
    padding: 0;
  }

  .tags li {
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  footer {
    padding-top: 4rem;
    padding-bottom: 3rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  footer p {
    margin: 0;
  }
</style>
