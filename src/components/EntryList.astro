---
import { Image } from 'astro:assets';
import type { Entry } from '../data/site';

interface Props {
  items: Entry[];
  /** 顯示 body 詳細段落（分頁用），首頁只顯示摘要 */
  detailed?: boolean;
}

const { items, detailed = false } = Astro.props;
---

<ul class="entries">
  {
    items.map((item) => (
      <li>
        <div class="entry-head">
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <span class="date">{item.date}</span>
        </div>
        {item.subtitle && <p class="subtitle">{item.subtitle}</p>}
        {item.description && <p>{item.description}</p>}
        {detailed && item.body?.map((paragraph) => <p class="body">{paragraph}</p>)}
        {item.tags && (
          <ul class="tags">
            {item.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
        {item.photos && (
          <div
            class="photos"
            style={`--ratio: ${item.photos.reduce((sum, { src }) => sum + src.width / src.height, 0)}`}
          >
            {item.photos.map(({ src, alt }) => (
              <Image
                class="photo"
                src={src}
                alt={alt}
                widths={[480, 800, 1200]}
                sizes="(max-width: 720px) 100vw, 40rem"
                style={`flex: ${(100 * src.width) / src.height} 1 0`}
              />
            ))}
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  .entries {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .date {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  p {
    margin: 0.375rem 0 0;
    color: var(--muted);
  }

  .subtitle {
    margin-top: 0.25rem;
  }

  .body {
    margin-top: 0.75rem;
    color: var(--fg);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.875rem 0 0;
    padding: 0;
  }

  /* 照片同一列等高，整列最高約 15rem，窄螢幕跟著等比例縮小 */
  .photos {
    display: flex;
    gap: 0.5rem;
    width: min(100%, calc(var(--ratio) * 15rem));
    margin-top: 1rem;
  }

  :global(.photo) {
    display: block;
    min-width: 0;
    height: auto;
    border-radius: 0.75rem;
  }

  .tags li {
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--card);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
