---
import Page from '../layouts/Page.astro';
import EntryList from '../components/EntryList.astro';
import { useI18n } from '../i18n';

const { t, data } = useI18n(Astro.url);
---

<Page title={t.awards.title} lead={t.awards.lead} sections={data.awardSections}>
  <section aria-labelledby="others">
    <h2 id="others">{t.awards.others}</h2>
    <EntryList items={data.otherEntries} />
  </section>
</Page>

<style>
  section {
    margin-bottom: 3.5rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
</style>
