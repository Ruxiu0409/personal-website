---
import AppDoc from '../layouts/AppDoc.astro';
import { getAppLang, privacy } from '../data/xddd';

const doc = privacy[getAppLang(Astro.url)];
---

<AppDoc title={doc.title} lead={doc.lead} meta={doc.effective} path="/xddd/privacy/">
  {
    doc.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.body?.map((paragraph) => <p set:html={paragraph} />)}
        {section.list && (
          <ul>
            {section.list.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        )}
        {section.after?.map((paragraph) => <p set:html={paragraph} />)}
      </section>
    ))
  }
</AppDoc>
