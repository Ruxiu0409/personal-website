---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import EntryList from '../components/EntryList.astro';
import { useI18n } from '../i18n';

const { t, data } = useI18n(Astro.url);
const { education, experienceSections, skillGroups } = data;
---

<Page title={t.experience.title} lead={t.experience.lead} sections={experienceSections}>
  <section slot="before" aria-labelledby="education">
    <h2 id="education">{t.experience.education}</h2>
    <EntryList items={education} />
  </section>

  <section aria-labelledby="skills">
    <h2 id="skills">{t.experience.skills}</h2>
    {
      skillGroups.map((group) => (
        <>
          <h3>{group.label}</h3>
          <ul class="languages">
            {group.items.map(({ name, icon: Icon, image, mono }) => (
              <li>
                {image ? (
                  <Image class="app-icon" src={image} alt="" width={36} height={36} densities={[1, 2, 3]} />
                ) : Icon ? (
                  <Icon width={36} height={36} aria-hidden="true" />
                ) : (
                  <span class="mono" aria-hidden="true">
                    {mono}
                  </span>
                )}
                <span>{name}</span>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </section>
</Page>

<style>
  section {
    margin-bottom: 5.5rem;
    scroll-margin-top: 6rem;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  h3 {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .languages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
  }

  .languages li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding: 1.25rem 0.5rem 1rem;
    background: var(--card);
    border-radius: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: border-color 0.15s, transform 0.15s;
  }

  .languages li:hover {
    transform: translateY(-2px);
  }

  /* 單色灰色剪影，滑鼠移上去時變深 */
  .languages :global(svg) {
    display: block;
    color: var(--muted);
    transition: color 0.15s;
  }

  .languages li:hover :global(svg) {
    color: var(--fg);
  }

  /* 沒有官方圖示的技能：用縮寫做成和圖示同大小的灰色字標 */
  /* 彩色 App 圖示本身就有圓角，不再加框 */
  :global(.app-icon) {
    display: block;
    width: 36px;
    height: 36px;
  }

  .mono {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 2px solid var(--muted);
    border-radius: 9px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color 0.15s, border-color 0.15s;
  }

  .languages li:hover .mono {
    color: var(--fg);
    border-color: var(--fg);
  }

  .languages li > span:last-child {
    text-align: center;
    line-height: 1.3;
  }
</style>
