---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import avatar from '../assets/avatar.jpg';
// Raycast 標誌取自 Simple Icons（CC0）。
import RaycastIcon from '../assets/icons/raycast.svg';
import type { Entry } from '../data/site';
import { useI18n } from '../i18n';

const { t, data, href } = useI18n(Astro.url);
const { site, experienceSections, awardSections, communitySections, portfolio, story, traits, closing } = data;

const pick = (sections: { id: string; items: Entry[] }[], id: string, count: number) =>
  sections.find((section) => section.id === id)?.items.slice(0, count) ?? [];

const highlights = [
  {
    id: 'experience',
    label: t.experience.title,
    href: href('/experience/'),
    items: [...pick(experienceSections, 'research', 1), ...pick(experienceSections, 'publications', 1)],
  },
  {
    id: 'awards',
    label: t.awards.title,
    href: href('/awards/'),
    items: pick(awardSections, 'awards', 3),
  },
  {
    id: 'community',
    label: t.community.title,
    href: href('/community/'),
    items: [...pick(communitySections, 'roles', 2), ...pick(communitySections, 'wwdc', 1)],
  },
];
---

<Base>
  <main class="container">
    <header class="hero">
      <a class="badge" href={site.badge.href} rel="noopener">
        <RaycastIcon width={16} height={16} aria-hidden="true" />
        {site.badge.label}
        <span aria-hidden="true">→</span>
      </a>
      <Image
        class="avatar"
        src={avatar}
        alt={site.name}
        width={112}
        height={112}
        densities={[1, 2, 3]}
        loading="eager"
      />
      <p class="eyebrow">{site.location}</p>
      <h1>{site.name} <span class="name-en">{site.nameEn}</span></h1>
      <p class="nickname">{site.nickname}</p>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">{site.intro}</p>
      <nav class="links" aria-label={t.socialNav}>
        {site.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </header>

    <section aria-labelledby="about">
      <h2 id="about" class="ruled">{t.about.title}</h2>
      <div class="story">
        {
          story.map((chapter) => (
            <article>
              <h3>{chapter.title}</h3>
              {chapter.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </article>
          ))
        }
      </div>
      <h3 class="subhead">{t.about.traits}</h3>
      <div class="traits">
        {
          traits.map((trait) => (
            <article>
              <h4>{trait.title}</h4>
              <p>{trait.paragraph}</p>
            </article>
          ))
        }
      </div>
      <blockquote>{closing}</blockquote>
    </section>

    <section aria-labelledby="portfolio">
      <div class="section-head">
        <h2 id="portfolio">{t.portfolio.title}</h2>
        <a href={href('/portfolio/')}>{t.seeAll}</a>
      </div>
      <div class="cards">
        {
          portfolio.slice(0, 2).map((project) => (
            <ProjectCard
              project={project}
              awardLabel={t.portfolio.award}
              href={`${href('/portfolio/')}#${project.slug}`}
            />
          ))
        }
      </div>
    </section>

    {
      highlights.map((section) => (
        <section aria-labelledby={section.id}>
          <div class="section-head">
            <h2 id={section.id}>{section.label}</h2>
            <a href={section.href}>{t.seeAll}</a>
          </div>
          <EntryList items={section.items} />
        </section>
      ))
    }
  </main>
</Base>

<style>
  .hero {
    padding: 5rem 0 4rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 0.375rem 0.875rem 0.375rem 0.75rem;
    border: 1px solid rgba(255, 99, 99, 0.35);
    border-radius: 999px;
    background: rgba(255, 99, 99, 0.08);
    color: var(--fg);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .badge :global(svg) {
    color: #ff6363;
  }

  .badge span {
    color: var(--muted);
    transition: transform 0.2s;
  }

  .badge:hover {
    color: var(--fg);
    background: rgba(255, 99, 99, 0.14);
    border-color: rgba(255, 99, 99, 0.6);
  }

  .badge:hover span {
    transform: translateX(2px);
  }

  .avatar {
    display: block;
    width: 7rem;
    height: 7rem;
    margin-bottom: 2rem;
    border-radius: 22%;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* 英文名放在中文名右邊，同一行、底線對齊 */
  .name-en {
    display: inline-block;
    margin-left: 0.75rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0;
  }

  .nickname {
    margin: 0.75rem 0 0;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tagline {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .intro {
    margin: 1.25rem 0 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
    font-weight: 500;
  }

  section {
    margin-bottom: 3.5rem;
  }

  .ruled {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .story article + article {
    margin-top: 2rem;
  }

  .story h3,
  .subhead {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .story p {
    margin: 0.5rem 0 0;
  }

  .subhead {
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .traits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }

  .traits article {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--card);
  }

  h4 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .traits p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  blockquote {
    margin: 2.5rem 0 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .section-head a {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--accent);
  }
</style>
