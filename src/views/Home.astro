---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import heroPhoto from '../assets/hero.jpg';
// Raycast 標誌取自 Simple Icons（CC0）。
import RaycastIcon from '../assets/icons/raycast.svg';
// 社群平台圖示：GitHub、Instagram、X 取自 Simple Icons（CC0），
// LinkedIn 取自 Devicon（MIT），Email 取自 Material Design Icons（Apache 2.0）。
import GitHubIcon from '../assets/icons/github.svg';
import LinkedInIcon from '../assets/icons/linkedin.svg';
import InstagramIcon from '../assets/icons/instagram.svg';
import XIcon from '../assets/icons/x.svg';
import EmailIcon from '../assets/icons/email.svg';
import type { Entry } from '../data/site';
import { useI18n } from '../i18n';

const { t, data, href } = useI18n(Astro.url);
const { site, experienceSections, awardSections, communitySections, portfolio, story, traits, closing } = data;

const socialIcons = {
  GitHub: GitHubIcon,
  LinkedIn: LinkedInIcon,
  Instagram: InstagramIcon,
  X: XIcon,
  Email: EmailIcon,
} as const;

const pick = (sections: { id: string; items: Entry[] }[], id: string, count: number) =>
  sections.find((section) => section.id === id)?.items.slice(0, count) ?? [];

const highlights = [
  {
    id: 'experience',
    label: t.experience.title,
    href: href('/experience/'),
    items: [...pick(experienceSections, 'research', 1), ...pick(experienceSections, 'publications', 1)],
  },
  {
    id: 'awards',
    label: t.awards.title,
    href: href('/awards/'),
    items: pick(awardSections, 'awards', 3),
  },
  {
    id: 'community',
    label: t.community.title,
    href: href('/community/'),
    items: [...pick(communitySections, 'roles', 2), ...pick(communitySections, 'wwdc', 1)],
  },
];
---

<Base>
  <!-- 參考 Apple.com：一打開就是一張滿版大圖，上面只放名字、一句話和幾個標籤 -->
  <header class="hero">
    <Image
      class="hero-photo"
      src={heroPhoto}
      alt={site.heroAlt}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-content">
      <a class="badge" href={site.badge.href} rel="noopener">
        <RaycastIcon width={16} height={16} aria-hidden="true" />
        {site.badge.label}
        <span aria-hidden="true">→</span>
      </a>
      <h1>{site.name} <span class="name-en">{site.nameEn}</span></h1>
      <p class="nickname">{site.nickname} · {site.tagline}</p>
      <ul class="tags">
        {site.heroTags.map((tag) => <li>{tag}</li>)}
      </ul>
      <nav class="links" aria-label={t.socialNav}>
        {
          site.links.map((link) => {
            const Icon = socialIcons[link.label as keyof typeof socialIcons];
            return (
              <a
                href={link.href}
                rel={link.href.startsWith('http') ? 'me noopener' : undefined}
                aria-label={link.label}
                title={link.label}
              >
                {Icon && <Icon width={20} height={20} aria-hidden="true" />}
              </a>
            );
          })
        }
      </nav>
    </div>
  </header>

  <main class="container">

    <section aria-labelledby="about">
      <h2 id="about" class="ruled">{t.about.title}</h2>
      <p class="lead">{site.intro}</p>
      <div class="story">
        {
          story.map((chapter) => (
            <article>
              <h3>{chapter.title}</h3>
              {chapter.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </article>
          ))
        }
      </div>
      <h3 class="subhead">{t.about.traits}</h3>
      <div class="traits">
        {
          traits.map((trait) => (
            <article>
              <h4>{trait.title}</h4>
              <p>{trait.paragraph}</p>
            </article>
          ))
        }
      </div>
      <blockquote>{closing}</blockquote>
    </section>

    <section aria-labelledby="portfolio">
      <div class="section-head">
        <h2 id="portfolio">{t.portfolio.title}</h2>
        <a href={href('/portfolio/')}>{t.seeAll}</a>
      </div>
      <div class="cards">
        {
          portfolio.slice(0, 2).map((project) => (
            <ProjectCard
              project={project}
              awardLabel={t.portfolio.award}
              href={`${href('/portfolio/')}#${project.slug}`}
            />
          ))
        }
      </div>
    </section>

    {
      highlights.map((section) => (
        <section aria-labelledby={section.id}>
          <div class="section-head">
            <h2 id={section.id}>{section.label}</h2>
            <a href={section.href}>{t.seeAll}</a>
          </div>
          <EntryList items={section.items} />
        </section>
      ))
    }
  </main>
</Base>

<style>
  /* 首頁主視覺：滿版照片卡，手機打開幾乎整個畫面都是照片 */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    width: calc(100% - 2rem);
    max-width: 72rem;
    height: min(calc(100svh - 7rem), 52rem);
    min-height: 34rem;
    margin: 1rem auto 4rem;
    overflow: hidden;
    border-radius: 2rem;
    background: #9cc3e8;
    color: #fff;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 人在照片中間偏右上，裁切時讓臉保持在畫面裡 */
    object-position: 55% 35%;
  }

  /* 底部漸層，讓白字在亮色天空上也看得清楚 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.25) 38%, transparent 62%);
  }

  .hero-content {
    width: 100%;
    padding: 2.5rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.375rem 0.875rem 0.375rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  .badge :global(svg) {
    color: #ff6363;
  }

  .badge:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.28);
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  /* 英文名放在中文名右邊，同一行、底線對齊 */
  .name-en {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: clamp(1.125rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0;
    opacity: 0.85;
  }

  .nickname {
    margin: 0.875rem 0 0;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.3125rem 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .links {
    display: flex;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .links a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    transition: background 0.2s, transform 0.2s;
  }

  .links a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.32);
    transform: translateY(-2px);
  }

  .lead {
    margin: 0 0 2.5rem;
    font-size: 1.25rem;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .hero {
      width: calc(100% - 1rem);
      height: calc(100svh - 8.5rem);
      min-height: 30rem;
      margin-top: 0.5rem;
      border-radius: 1.5rem;
    }

    .hero-photo {
      object-position: 58% 30%;
    }

    .hero-content {
      padding: 1.5rem 1.25rem;
    }

    .tags li {
      font-size: 0.8125rem;
    }

    .lead {
      font-size: 1.125rem;
    }
  }

  section {
    margin-bottom: 3.5rem;
  }

  .ruled {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .story article + article {
    margin-top: 2rem;
  }

  .story h3,
  .subhead {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .story p {
    margin: 0.5rem 0 0;
  }

  .subhead {
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .traits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }

  .traits article {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--card);
  }

  h4 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .traits p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  blockquote {
    margin: 2.5rem 0 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .section-head a {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--accent);
  }
</style>
