---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import heroPhoto from '../assets/hero.jpg';
// Raycast 標誌取自 Simple Icons（CC0）。
import RaycastIcon from '../assets/icons/raycast.svg';
// 社群平台圖示：GitHub、Instagram、X 取自 Simple Icons（CC0），
// LinkedIn 取自 Devicon（MIT），Email 取自 Material Design Icons（Apache 2.0）。
import GitHubIcon from '../assets/icons/github.svg';
import LinkedInIcon from '../assets/icons/linkedin.svg';
import InstagramIcon from '../assets/icons/instagram.svg';
import XIcon from '../assets/icons/x.svg';
import EmailIcon from '../assets/icons/email.svg';
import type { Entry } from '../data/site';
import { useI18n } from '../i18n';

const { t, data, href } = useI18n(Astro.url);
const { site, experienceSections, awardSections, communitySections, portfolio, story, traits, closing } = data;

const socialIcons = {
  GitHub: GitHubIcon,
  LinkedIn: LinkedInIcon,
  Instagram: InstagramIcon,
  X: XIcon,
  Email: EmailIcon,
} as const;

const pick = (sections: { id: string; items: Entry[] }[], id: string, count: number) =>
  sections.find((section) => section.id === id)?.items.slice(0, count) ?? [];

const highlights = [
  {
    id: 'experience',
    label: t.experience.title,
    href: href('/experience/'),
    items: [...pick(experienceSections, 'research', 1), ...pick(experienceSections, 'publications', 1)],
  },
  {
    id: 'awards',
    label: t.awards.title,
    href: href('/awards/'),
    items: pick(awardSections, 'awards', 4),
  },
  {
    id: 'community',
    label: t.community.title,
    href: href('/community/'),
    items: [...pick(communitySections, 'roles', 2), ...pick(communitySections, 'wwdc', 1)],
  },
];
---

<Base>
  <!-- 參考 Apple.com：一打開就是一張滿版大圖，上面只放名字、一句話和幾個標籤 -->
  <header class="hero">
    <Image
      class="hero-photo"
      src={heroPhoto}
      alt={site.heroAlt}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-content">
      <a class="badge" href={site.badge.href} rel="noopener">
        <RaycastIcon width={16} height={16} aria-hidden="true" />
        {site.badge.label}
        <span aria-hidden="true">→</span>
      </a>
      <h1>{site.name} <span class="name-en">{site.nameEn}</span></h1>
      <p class="nickname">{site.nickname} · {site.tagline}</p>
      <ul class="tags">
        {site.heroTags.map((tag) => <li>{tag}</li>)}
      </ul>
      <nav class="links" aria-label={t.socialNav}>
        {
          site.links.map((link) => {
            const Icon = socialIcons[link.label as keyof typeof socialIcons];
            return (
              <a
                href={link.href}
                rel={link.href.startsWith('http') ? 'me noopener' : undefined}
                aria-label={link.label}
                title={link.label}
              >
                {Icon && <Icon width={20} height={20} aria-hidden="true" />}
              </a>
            );
          })
        }
      </nav>
    </div>
  </header>

  <main>
    <!-- 作品放在主視覺正下方：一排可橫向滑動的大圖，每張只留標題、獎項和日期 -->
    <section class="showcase" aria-labelledby="portfolio">
      <div class="section-head wide">
        <h2 id="portfolio">{t.portfolio.title}</h2>
        <a href={href('/portfolio/')}>{t.seeAll}</a>
      </div>
      <ul class="rail">
        {
          portfolio.map((project) => (
            <li>
              <a class="tile" href={`${href('/portfolio/')}#${project.slug}`}>
                <div class="frame">
                  {project.image ? (
                    <Image
                      class:list={[project.image.height > project.image.width && 'portrait']}
                      src={project.image}
                      alt={project.imageAlt ?? project.title}
                      widths={[480, 720, 960]}
                      sizes="(max-width: 720px) 80vw, 22rem"
                    />
                  ) : (
                    <span class="placeholder" aria-hidden="true">
                      {project.title.slice(0, 1)}
                    </span>
                  )}
                </div>
                <h3>{project.title}</h3>
                {project.award && <p class="award">{project.award}</p>}
                <p class="date">{project.date}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 關於我：一句大字開場，故事用左標題、右內文的雜誌式排版，不加框線 -->
    <section class="container about" aria-labelledby="about">
      <h2 id="about">{t.about.title}</h2>
      <p class="lead">{site.intro}</p>

      <h3 class="label">{t.about.story}</h3>
      <div class="story">
        {
          story.map((chapter) => (
            <article>
              <h4>{chapter.title}</h4>
              <div>
                {chapter.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <h3 class="label">{t.about.traits}</h3>
      <div class="traits">
        {
          traits.map((trait) => (
            <article>
              <h4>{trait.title}</h4>
              <p>{trait.paragraph}</p>
            </article>
          ))
        }
      </div>

      <blockquote>{closing}</blockquote>
    </section>

    <!-- 經歷、競賽、社群：只列標題和日期，細節留給各自的分頁 -->
    {
      highlights.map((section) => (
        <section class="container" aria-labelledby={section.id}>
          <div class="section-head">
            <h2 id={section.id}>{section.label}</h2>
            <a href={section.href}>{t.seeAll}</a>
          </div>
          <ul class="brief">
            {section.items.map((item) => (
              <li>
                <div>
                  <p class="brief-title">
                    {item.href ? <a href={item.href}>{item.title}</a> : item.title}
                  </p>
                  {item.subtitle && <p class="brief-sub">{item.subtitle}</p>}
                </div>
                <span class="date">{item.date}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>

<style>
  /* 首頁主視覺：全版照片，上、左、右貼齊畫面邊緣，導覽列浮在照片上 */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100svh;
    min-height: 34rem;
    /* 往上拉過導覽列佔的高度（上方間距 + 膠囊高度），讓照片從畫面最頂端開始 */
    margin: calc(-1 * var(--header-offset)) 0 0;
    overflow: hidden;
    background: var(--bg);
    color: #fff;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 人在照片中間偏右上，裁切時讓臉保持在畫面裡 */
    object-position: 55% 35%;
  }

  /* 底部漸層，讓白字在亮色天空上也看得清楚 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.25) 38%, transparent 62%);
  }

  .hero-content {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 2.5rem 3rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.375rem 0.875rem 0.375rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  .badge :global(svg) {
    color: #ff6363;
  }

  .badge:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.28);
  }

  /* 中英文名字永遠在同一行；手機上用 vw 縮放字級讓整行放得下 */
  h1 {
    margin: 0;
    white-space: nowrap;
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  /* 英文名放在中文名右邊，同一行、底線對齊 */
  .name-en {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: clamp(1.125rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0;
    opacity: 0.85;
  }

  .nickname {
    margin: 0.875rem 0 0;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.3125rem 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .links {
    display: flex;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .links a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    transition: background 0.2s, transform 0.2s;
  }

  .links a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.32);
    transform: translateY(-2px);
  }

  @media (max-width: 720px) {
    .hero {
      height: 100svh;
      min-height: 30rem;
    }

    .hero-photo {
      object-position: 58% 30%;
    }

    .hero-content {
      padding: 1.5rem 1.25rem;
    }

    h1 {
      font-size: 12vw;
    }

    :global(html[lang='en']) h1 {
      font-size: 9vw;
    }

    .name-en {
      margin-left: 0.375rem;
      font-size: 4.4vw;
    }

    /* 手機：臉在照片約 40% 的高度，文字區塊要縮在下方三分之一，不能蓋到臉 */
    .badge {
      position: absolute;
      /* 導覽列浮在照片上，徽章放在導覽列下方 */
      top: calc(var(--header-offset) + 0.75rem);
      left: 1rem;
      margin: 0;
      padding: 0.3125rem 0.75rem 0.3125rem 0.625rem;
      font-size: 0.8125rem;
    }

    .nickname {
      margin-top: 0.5rem;
      font-size: 1.125rem;
    }

    /* 標籤不滑動，放不下就自動換行 */
    .tags {
      gap: 0.375rem;
      margin-top: 0.875rem;
    }

    .tags li {
      padding: 0.25rem 0.75rem;
      font-size: 0.8125rem;
      white-space: nowrap;
    }

    .links {
      margin-top: 1rem;
    }

    .links a {
      width: 2.5rem;
      height: 2.5rem;
    }

    /* 漸層只壓在底部，不讓臉變暗 */
    .hero::after {
      background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.35) 28%, transparent 46%);
    }
  }

  /* 主視覺以下：大量留白，區塊之間只用間距分隔 */
  main {
    padding-bottom: 8rem;
  }

  main > section {
    margin-top: 7rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* 作品區標題對齊主視覺的寬度 */
  .section-head.wide {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .section-head a {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--accent);
  }

  /* 橫向滑動作品列：滿版延伸到畫面邊緣，起點對齊上方標題，不用 JS */
  .rail {
    --inset: max(1.5rem, calc((100% - 72rem) / 2 + 1.5rem));
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0 var(--inset) 1rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--inset);
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail li {
    flex: 0 0 20rem;
    scroll-snap-align: start;
  }

  .tile {
    display: block;
    color: inherit;
    text-decoration: none;
    text-align: center;
  }

  /* 圖片統一放在淡色方框裡；手機截圖直式置中，橫式圖撐滿寬度 */
  .frame {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 1.5rem;
    overflow: hidden;
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--fg) 4%, var(--bg));
  }

  /* 圖片撐滿方框再用 contain 等比縮小，任何尺寸都不會被裁到 */
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .tile:hover .frame :global(img) {
    transform: scale(1.03);
  }

  .placeholder {
    color: var(--muted);
    font-size: 4rem;
    font-weight: 600;
  }

  .tile h3 {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .tile:hover h3 {
    color: var(--accent);
  }

  .award {
    margin: 0.375rem 0 0;
    color: var(--accent);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .date {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .tile .date {
    margin: 0.25rem 0 0;
  }

  /* 關於我：放寬一點的文字欄 */
  .about {
    max-width: 48rem;
  }

  .about h2 {
    margin-bottom: 2rem;
  }

  .lead {
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  .label {
    margin: 5rem 0 2rem;
    color: var(--muted);
    font-size: 1rem;
    font-weight: 500;
  }

  /* 故事：左邊窄欄放章節名，右邊放內文 */
  .story article {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2.5rem;
  }

  .story article + article {
    margin-top: 3rem;
  }

  h4 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .story p {
    margin: 0;
  }

  .story p + p {
    margin-top: 1rem;
  }

  /* 特質：三個淡底小塊，不加框線 */
  .traits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }

  .traits article {
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--fg) 3%, var(--bg));
  }

  .traits h4 {
    margin-bottom: 0.5rem;
  }

  .traits p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  blockquote {
    max-width: 36rem;
    margin: 5rem auto 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.8;
    text-align: center;
  }

  /* 經歷精選：每項一行標題加日期，最多一行副標 */
  .brief {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brief li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }

  .brief li + li {
    margin-top: 1.5rem;
  }

  .brief li > div {
    min-width: 0;
  }

  .brief-title {
    margin: 0;
    font-weight: 500;
    line-height: 1.5;
  }

  .brief-title a {
    text-decoration: none;
  }

  .brief-sub {
    margin: 0.125rem 0 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .brief .date {
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    main {
      padding-bottom: 5rem;
    }

    main > section {
      margin-top: 4rem;
    }

    .section-head {
      margin-bottom: 1.5rem;
    }

    .rail {
      gap: 1rem;
    }

    /* 手機上一張約八成寬，讓下一張露出一角 */
    .rail li {
      flex-basis: 80vw;
    }

    .frame {
      padding: 1.25rem;
    }

    .label {
      margin-top: 3.5rem;
    }

    .story article {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .story article + article {
      margin-top: 2.5rem;
    }

    blockquote {
      margin-top: 3.5rem;
      font-size: 1.0625rem;
    }

    .brief li {
      flex-direction: column;
      gap: 0.125rem;
    }

    .brief-sub {
      white-space: normal;
    }
  }
</style>
