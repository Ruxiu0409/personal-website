---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import avatar from '../assets/avatar.jpg';
// Raycast 標誌取自 Simple Icons（CC0）。
import RaycastIcon from '../assets/icons/raycast.svg';
import type { Entry } from '../data/site';
import { useI18n } from '../i18n';

const { t, data, href } = useI18n(Astro.url);
const { site, experienceSections, awardSections, communitySections } = data;

const pick = (sections: { id: string; items: Entry[] }[], id: string, count: number) =>
  sections.find((section) => section.id === id)?.items.slice(0, count) ?? [];

const highlights = [
  {
    id: 'experience',
    label: t.experience.title,
    href: href('/experience/'),
    items: [...pick(experienceSections, 'research', 1), ...pick(experienceSections, 'projects', 1)],
  },
  {
    id: 'awards',
    label: t.awards.title,
    href: href('/awards/'),
    items: pick(awardSections, 'awards', 3),
  },
  {
    id: 'community',
    label: t.community.title,
    href: href('/community/'),
    items: [...pick(communitySections, 'roles', 2), ...pick(communitySections, 'wwdc', 1)],
  },
];
---

<Base>
  <main class="container">
    <header class="hero">
      <a class="badge" href={site.badge.href} rel="noopener">
        <RaycastIcon width={16} height={16} aria-hidden="true" />
        {site.badge.label}
        <span aria-hidden="true">→</span>
      </a>
      <Image
        class="avatar"
        src={avatar}
        alt={site.name}
        width={112}
        height={112}
        densities={[1, 2, 3]}
        loading="eager"
      />
      <p class="eyebrow">{site.location}</p>
      <h1>{site.name} <span class="name-en">{site.nameEn}</span></h1>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">{site.intro} <a href={href('/about/')}>{t.moreAbout}</a></p>
      <nav class="links" aria-label={t.socialNav}>
        {site.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </header>

    {
      highlights.map((section) => (
        <section aria-labelledby={section.id}>
          <div class="section-head">
            <h2 id={section.id}>{section.label}</h2>
            <a href={section.href}>{t.seeAll}</a>
          </div>
          <EntryList items={section.items} />
        </section>
      ))
    }
  </main>
</Base>

<style>
  .hero {
    padding: 5rem 0 4rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 0.375rem 0.875rem 0.375rem 0.75rem;
    border: 1px solid rgba(255, 99, 99, 0.35);
    border-radius: 999px;
    background: rgba(255, 99, 99, 0.08);
    color: var(--fg);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .badge :global(svg) {
    color: #ff6363;
  }

  .badge span {
    color: var(--muted);
    transition: transform 0.2s;
  }

  .badge:hover {
    color: var(--fg);
    background: rgba(255, 99, 99, 0.14);
    border-color: rgba(255, 99, 99, 0.6);
  }

  .badge:hover span {
    transform: translateX(2px);
  }

  .avatar {
    display: block;
    width: 7rem;
    height: 7rem;
    margin-bottom: 2rem;
    border-radius: 22%;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .name-en {
    display: block;
    margin-top: 0.5rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0;
  }

  .tagline {
    margin: 1rem 0 0;
    font-size: 1.25rem;
  }

  .intro {
    margin: 1.25rem 0 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .intro a {
    color: var(--fg);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
    font-weight: 500;
  }

  section {
    margin-bottom: 3.5rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .section-head a {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--accent);
  }
</style>
