---
import AppDoc from '../layouts/AppDoc.astro';
import { getAppLang, support } from '../data/xddd';

const doc = support[getAppLang(Astro.url)];
---

<AppDoc title={doc.title} lead={doc.lead} path="/xddd/support/">
  <section>
    <h2>{doc.faqHeading}</h2>
    {
      doc.faq.map((item) => (
        <>
          <h3>{item.q}</h3>
          {item.a.map((paragraph) => <p set:html={paragraph} />)}
        </>
      ))
    }
  </section>
  {
    doc.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.body?.map((paragraph) => <p set:html={paragraph} />)}
      </section>
    ))
  }
</AppDoc>
